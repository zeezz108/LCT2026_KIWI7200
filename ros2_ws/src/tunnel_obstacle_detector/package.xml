<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tunnel_obstacle_detector</name>
  <version>0.1.0</version>
  <description>
    Obstacle detection ahead of a driverless metro train from 3D lidar: track-bed calibration,
    curved clearance corridor estimation, free-envelope check and temporal confirmation.
  </description>
  <maintainer email="z7ezz1@gmail.com">LCT 2026 team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>vision_msgs</depend>
  <depend>rosbag2_cpp</depend>
  <depend>tf2_ros</depend>
  <depend>tunnel_obstacle_msgs</depend>
  <depend>eigen</depend>

  <exec_depend>rosbag2_storage_default_plugins</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
