Panels: []
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid (track bed, 5 m)
      Enabled: true
      Reference Frame: <Fixed Frame>
      Cell Size: 5
      Plane Cell Count: 60
      Color: 90; 90; 110
      Alpha: 0.25
      Offset:
        X: 145
        Y: 0
        Z: 0
    - Class: rviz_default_plugins/PointCloud2
      Name: Lidar (zone coloured)
      Enabled: true
      Topic:
        Value: /tunnel_obstacle_detector/view_points
        Depth: 2
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Durability Policy: Volatile
      Style: Points
      Size (Pixels): 2
      Alpha: 1
      Color Transformer: Intensity
      Channel Name: zone
      Use rainbow: false
      Min Color: 80; 110; 170
      Max Color: 255; 40; 40
      Autocompute Intensity Bounds: false
      Min Intensity: 0
      Max Intensity: 2
      Position Transformer: XYZ
      Decay Time: 0
    - Class: rviz_default_plugins/PointCloud2
      Name: Obstacle points
      Enabled: true
      Topic:
        Value: /tunnel_obstacle_detector/obstacle_points
        Depth: 2
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Durability Policy: Volatile
      Style: Points
      Size (Pixels): 7
      Alpha: 1
      Color Transformer: FlatColor
      Color: 255; 30; 30
      Position Transformer: XYZ
      Decay Time: 0
    - Class: rviz_default_plugins/MarkerArray
      Name: Corridor and obstacles
      Enabled: true
      Topic:
        Value: /tunnel_obstacle_detector/markers
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Volatile
  Enabled: true
  Global Options:
    Fixed Frame: track
    Background Color: 18; 18; 26
    Frame Rate: 15
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Demo
      Distance: 42
      Focal Point:
        X: 36
        Y: 0
        Z: 1
      Pitch: 0.24
      Yaw: 3.1416
      Near Clip Distance: 0.05
      Target Frame: <Fixed Frame>
    Saved: ~
Window Geometry:
  Height: 1080
  Width: 1920
  Hide Left Dock: true
  Hide Right Dock: true
  Displays:
    collapsed: true
