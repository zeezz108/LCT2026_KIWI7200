Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 10
      Plane Cell Count: 40
      Offset:
        X: 0
        Y: 0
        Z: -1.4
    - Class: rviz_default_plugins/PointCloud2
      Name: Lidar
      Enabled: true
      Topic:
        Value: /lidar_points
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Style: Points
      Size (Pixels): 2
      Color Transformer: AxisColor
      Axis: Z
      Position Transformer: XYZ
      Decay Time: 0
  Enabled: true
  Global Options:
    Fixed Frame: hesai_lidar
    Background Color: 20; 20; 30
    Frame Rate: 30
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 30
      Focal Point:
        X: 0
        Y: -25
        Z: 0
      Pitch: 0.35
      Yaw: 1.57
Window Geometry:
  Height: 900
  Width: 1400
